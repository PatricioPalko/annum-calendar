description: Preserve SEO metadata and crawlable public content
globs: app/page.tsx,app/layout.tsx,app/**/page.tsx,app/sitemap.ts,app/robots.ts,app/manifest.ts,components/seo/**/*.{ts,tsx}
alwaysApply: false
